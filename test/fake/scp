#!/bin/sh
# Fake scp for tests: drops options, strips "box:" and the SFTP glob masking
# from remote paths, copies with cp -R. FAKE_SLEEP / FAKE_FAIL steer failures.
sflag=
while [ $# -gt 0 ]; do
  case $1 in
    -s) sflag=1; shift ;;
    -o|-i|-P|-F|-J|-c|-l|-S) shift 2 ;;
    -*) shift ;;
    *) break ;;
  esac
done
# Prints the value plus "." so a trailing newline survives $(...); the caller cuts the "." off.
conv() {
  case $1 in
    box:*)
      if [ -n "$2" ]; then printf '%s.' "${1#box:}" | sed 's/\\\([]*?[\\]\)/\1/g'; else printf '%s.' "${1#box:}"; fi ;;
    *) printf '%s.' "$1" ;;
  esac
}
[ -n "$sflag" ] || { echo "fake scp: -s (SFTP mode) missing" >&2; exit 2; }
# Like real scp in SFTP mode: only the source is glob-unmasked.
src=$(conv "$1" unmask); src=${src%.}
dst=$(conv "$2"); dst=${dst%.}
cp -R -- "$src" "$dst" || exit 1
if [ -n "$FAKE_SLEEP" ]; then
  sp=
  trap '[ -n "$sp" ] && kill "$sp" 2>/dev/null; exit 143' HUP INT TERM
  sleep "$FAKE_SLEEP" &
  sp=$!
  wait "$sp"
fi
if [ -n "$FAKE_FAIL" ]; then
  echo "$FAKE_FAIL" >&2
  exit 1
fi
exit 0
